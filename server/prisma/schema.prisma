generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(254)
  password  String   @db.VarChar(255)
  name      String   @db.VarChar(100)
  role      Role     @default(USER)
  phone     String?  @db.VarChar(30)
  address   String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @db.DateTime(3)

  // Relations
  properties Property[]
  bookings   Booking[]
  complaints Complaint[]
  sessions   AuthSession[]
}

model AuthSession {
  id        String    @id @db.VarChar(36)
  tokenHash String    @unique @db.Char(64)
  userId    Int
  expiresAt DateTime  @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Property {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  address   String   @db.VarChar(500)
  city      String   @db.VarChar(100)
  type      String   @db.VarChar(16) // HOSTEL, PG, FLAT
  rules     String?  @db.Text
  hasMess   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime(3)

  // Foreign Key
  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id])

  // Relations
  rooms      Room[]
  complaints Complaint[]
}

model Room {
  id          Int     @id @default(autoincrement())
  roomNumber  String  @db.VarChar(50)
  capacity    Int
  price       Decimal @db.Decimal(12, 2)
  type        String  @db.VarChar(16) // AC, NON-AC
  isAvailable Boolean @default(true)

  // Foreign Key
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])

  // Relations
  bookings Booking[]

  @@unique([propertyId, roomNumber])
}

model Booking {
  id          Int      @id @default(autoincrement())
  startDate   DateTime @db.DateTime(3)
  endDate     DateTime @db.DateTime(3)
  status      String   @db.VarChar(16) // PENDING, CONFIRMED, REJECTED, CANCELLED
  totalAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  // Foreign Keys
  userId Int
  user   User @relation(fields: [userId], references: [id])
  roomId Int
  room   Room @relation(fields: [roomId], references: [id])

  // Relations
  payments Payment[]

  @@index([userId, createdAt])
  @@index([roomId, status])
}

model Payment {
  id            Int      @id @default(autoincrement())
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime @default(now()) @db.DateTime(3)
  status        String   @db.VarChar(16) // PAID, PENDING, FAILED
  transactionId String?  @db.VarChar(191)

  // Foreign Key
  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id])
}

model Complaint {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(200)
  description String    @db.Text
  status      String    @db.VarChar(16) // OPEN, RESOLVED
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  resolvedAt  DateTime? @db.DateTime(3)

  // Foreign Keys
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])
}
