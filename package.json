{
    "name": "dormify",
    "version": "1.0.0",
    "description": "Root package to manage server and client",
    "scripts": {
        "check:delivery": "node scripts/check-delivery.js",
        "install-all": "npm install && cd server && npm install && cd ../client && npm install",
        "start": "concurrently \"npm run server\" \"npm run client\"",
        "dev": "npm start",
        "server": "cd server && npm start",
        "client": "cd client && npm run dev",
        "prisma:generate": "cd server && npx prisma generate",
        "setup": "node scripts/setup-local.js",
        "db:up": "docker compose up -d --wait mysql",
        "db:stop": "docker compose --profile tools stop phpmyadmin mysql",
        "db:status": "docker compose --profile tools ps mysql phpmyadmin",
        "db:admin": "docker compose --profile tools up -d --wait phpmyadmin",
        "db:admin:stop": "docker compose --profile tools stop phpmyadmin",
        "db:setup": "npm --prefix server run db:setup",
        "db:studio": "npm --prefix server run db:studio"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}
